# Environment
NODE_ENV=production
BACKEND_URL=https://your-api-url.railway.app
PORT=5000

# Database
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# Security
JWT_SECRET=your_jwt_secret_key

# Email Configuration (Resend)
RESEND_API_KEY=re_123456789
EMAIL_FROM=onboarding@resend.dev
EMAIL_RECEIVER=admin@example.com
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# SMTP Fallback (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_password

# Cloudinary (Media Hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URLs
FRONTEND_SIGNUP_URL=https://signup.yourdomain.com
FRONTEND_MEMBER_URL=https://member.yourdomain.com
FRONTEND_ADMIN_URL=https://admin.yourdomain.com
FRONTEND_URL=https://admin.yourdomain.com
MEMBER_PORTAL=https://member.yourdomain.com
COOKIE_DOMAIN=.yourdomain.com

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ESSENTIAL_PRICE_ID=price_...
STRIPE_PREMIUM_PRICE_ID=price_...

# Frontend Sync
VITE_API_URL=https://your-api-url.railway.app

# API Keys
GOOGLE_ADDRESS_VALIDATION_API_KEY=your_google_api_key
